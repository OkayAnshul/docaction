<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Calendar access is requested at the confirm step, never at launch, and only these two.
      There is no storage permission anywhere in this app: documents arrive through the
      Storage Access Framework or the Photo Picker, both of which grant per-file access.

      Everything the reminder feature needs — POST_NOTIFICATIONS, SCHEDULE_EXACT_ALARM,
      RECEIVE_BOOT_COMPLETED, and both receivers — is declared by :actions:reminder and
      arrives through manifest merging. Restating it here would let the two drift, and one
      of the things that module deliberately does *not* declare is USE_EXACT_ALARM.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      The product's central claim, enforced rather than asserted.

      ML Kit pulls in `com.google.android.datatransport:transport-backend-cct`, which declares
      INTERNET so it can post usage telemetry to Google, and WorkManager adds
      ACCESS_NETWORK_STATE to schedule it. Neither was visible in this file, but manifest
      merging put both in the shipped app — so the Play listing said "full network access",
      and a user who checked the permissions we invite them to check would have found us
      wrong.

      Text recognition itself is entirely on-device; only the optional logging wanted the
      network. Removing the permission is what makes "your documents never leave your phone"
      a property of the package rather than a promise in a document: with no INTERNET
      permission the platform refuses the connection whatever any dependency intends, now or
      after an upgrade nobody reads the release notes for.

      `ManifestWiringTest.theAppCannotReachTheNetwork` fails if this ever comes back.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocAction">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DocAction"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The headline flow. Filters name only what the engine can actually read: an app
              that appears in the share sheet for a .docx and then refuses it is worse than
              one that never appeared.
            -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="image/*" />
                <!--
                  CSV was in SEND_MULTIPLE but not here, so sharing three spreadsheets offered
                  DocAction and sharing one did not.

                  text/plain is the "class rep posts the week's schedule as a message" case —
                  there is no file to save anywhere, MainActivity has always handled
                  EXTRA_TEXT, and the engine has goldens for it. Without this filter that
                  path was simply unreachable.
                -->
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- The same set as SEND. They were inconsistent, which meant sharing several
                 spreadsheets offered no DocAction while sharing one did. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- "Open with" from a file manager or a browser download. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content"
                    android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:scheme="content" android:mimeType="text/csv" />
                <data android:scheme="content" android:mimeType="text/comma-separated-values" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <!-- Images were missing here, so "open with" never offered us for a photo. -->
                <data android:scheme="content" android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          Lets a camera app hand a photo back to us. No CAMERA permission anywhere in this
          app: `TakePicture` delegates to whichever camera app the user already has, which
          keeps the privacy claims honest and removes a permission prompt from the flow.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
